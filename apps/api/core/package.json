{
  "name": "@api/core",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#shared/*": {
      "types": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    }
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "migration:create": "typeorm migration:create src/database/migrations/$0",
    "migration:run": "nest build && node --env-file-if-exists=../../../.env ../../../node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:revert": "nest build && node --env-file-if-exists=../../../.env ../../../node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js",
    "migration:show": "nest build && node --env-file-if-exists=../../../.env ../../../node_modules/typeorm/cli.js migration:show -d dist/database/data-source.js",
    "db:seed": "nest build && node --env-file-if-exists=../../../.env dist/database/seed/demo.js",
    "db:seed:required": "nest build && node --env-file-if-exists=../../../.env dist/database/seed/required.js",
    "db:reset": "nest build && node --env-file-if-exists=../../../.env dist/database/reset.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@casl/ability": "^7.0.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "@repo/shared": "workspace:*",
    "@sentry/nestjs": "^10.70.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.20.0",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@repo/config": "workspace:*",
    "@swc/core": "^1.16.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8",
    "eslint": "^10.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
