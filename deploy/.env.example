# Copy to .env beside compose.yml on the server and fill in — this stack reads
# that file, not the .env at the repo root:
#
#     cd /srv/taskflow/deploy && cp .env.example .env && chmod 600 .env
#     docker compose up -d
#
# ทุกค่าในไฟล์นี้ไม่มี default ที่ใช้ได้จริง — ตั้งใจ ไม่มีอะไรที่ลืมแล้วยัง boot ผ่าน

# ── Site ─────────────────────────────────────────────────────────────────────

# hostname เดียวรับทั้งสองแอป — `/api/*` ไป NestJS ที่เหลือไป Next
# Caddy ขอ certificate เองจากค่านี้ · ใส่ `:80` เมื่อทดสอบบนเครื่องที่ไม่มี domain
SITE_ADDRESS=taskflow.example.com

# ── Database ─────────────────────────────────────────────────────────────────

# superuser ที่ image สร้าง · แอปไม่ได้ใช้ role นี้ ใช้ตอน restore/ดูแลเท่านั้น
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=taskflow

# role ที่แอปใช้จริง · docker/postgres-init.sh สร้างให้แบบ NOSUPERUSER
# migration รันได้ครบเพราะเป็นเจ้าของ database และ citext เป็น trusted extension
# สร้างครั้งเดียวตอน volume ว่าง — เปลี่ยนรหัสทีหลังต้อง ALTER ROLE เอง
APP_DB_USER=taskflow_app
APP_DB_PASSWORD=

# ── Object storage ───────────────────────────────────────────────────────────

# ในเครือข่าย compose แอปคุยกับ garage ที่ 3900 โดยตรง ไม่ผ่าน port 4xxx ของ dev
S3_BUCKET=taskflow
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# zone/capacity มีผลตอน layout ครั้งแรกเท่านั้น ดู .env.example
GARAGE_ZONE=dc1
GARAGE_CAPACITY=10000000000

# ── Email ────────────────────────────────────────────────────────────────────

# บังคับ — NODE_ENV=production แล้วไม่มีค่านี้ API จะไม่ boot
RESEND_API_KEY=
EMAIL_FROM="Taskflow <noreply@taskflow.example.com>"

# ── Observability ────────────────────────────────────────────────────────────

# บังคับเหมือน RESEND_API_KEY — production ที่ไม่ส่ง error ไปไหนคือความพังที่ไม่มีใครรู้
SENTRY_DSN=
# ฝั่ง browser · เป็น build arg ไม่ใช่ runtime env (Next ฝัง NEXT_PUBLIC_* ตอน build)
# เปลี่ยนค่านี้ต้อง --build ใหม่ ไม่ใช่แค่ restart
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_LEVEL=info

# ── Images ───────────────────────────────────────────────────────────────────

# CI push ขึ้น GHCR แล้ว server แค่ pull · ไม่ต้อง build บนเครื่อง production
# IMAGE_TAG คือทางกลับ: workflow tag ทุก image ด้วย commit SHA คู่กับ latest
# rollback = ตั้ง IMAGE_TAG เป็น sha เก่า แล้ว pull + up -d
IMAGE_PREFIX=ghcr.io/punchdrnt/taskflow
IMAGE_TAG=latest

# ── Jobs ─────────────────────────────────────────────────────────────────────

# retention + audit partition · ปิดได้เฉพาะตอนสืบสวนปัญหา ไม่ใช่ค่าปกติ
JOBS_ENABLED=true
