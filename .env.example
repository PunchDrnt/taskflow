# Copy to .env and adjust. Every variable the API reads is validated at boot
# by apps/api/core/src/config/env.ts — an unset or malformed value stops the
# process rather than surfacing as undefined mid-request.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# docker-compose postgres service
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# ถ้าเครื่องมี Postgres รันอยู่แล้วที่ 5432 ให้เปลี่ยนสองค่านี้ ไม่งั้น
# docker compose up จะล้มด้วย "port is already allocated"
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# ต้องตรงกับ POSTGRES_* ข้างบน · ไม่มี default ในโค้ด — ไม่ตั้งแล้ว API ไม่ boot
DATABASE_URL=postgresql://app:app@localhost:5432/app
# ใช้เฉพาะ integration test (service postgres-test) — ไม่อยู่ใน zod schema
# เพราะ API ห้ามต่อ DB ตัวนี้ · ไม่ตั้ง = integration test skip (CI ต้องตั้ง)
DATABASE_URL_TEST=postgresql://app:app@localhost:5433/app_test

# Retention + audit partition jobs (ตี 3 ตามเวลาไทย) · default true
# ตั้ง false บนเครื่อง dev ที่ต่อ DB ร่วมกับคนอื่น — สอง instance ไม่ต้องกังวล
# เพราะมี advisory lock กันอยู่แล้ว
JOBS_ENABLED=true

# MinIO (service minio ใน docker-compose) · bucket เป็น private เข้าผ่าน presigned URL
# 9000/9001 ชนง่ายมาก โปรเจกต์อื่นที่รัน MinIO อยู่จะจองไว้แล้ว — เปลี่ยนสองค่านี้
# MINIO_PORT ใช้ทั้งฝั่ง compose และฝั่ง client จึงมีตัวเดียวพอ
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=taskflow

# Resend · ไม่ตั้ง = EmailService เขียนลง log แทนการส่งจริง (dev เท่านั้น)
# NODE_ENV=production แล้วไม่ตั้ง = boot ไม่ผ่าน
# RESEND_API_KEY=
EMAIL_FROM=Taskflow <noreply@taskflow.local>

# Phase 0 adds: JWT_*
